# Weather Configuration (Open-Meteo requires no API key)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=

# Sentinel-2 / Earth Search STAC Configuration
SATELLITE_MODE=real
SATELLITE_API_URL=https://earth-search.aws.element84.com/v1
SATELLITE_API_KEY=
SATELLITE_AOI_RADIUS_METERS=100
SATELLITE_MAX_CLOUD_COVER=20
SATELLITE_HISTORY_TOLERANCE_DAYS=4

# Soil Service Configuration (soilgrids_rest | soilgrids_wcs)
SOIL_MODE=real
SOIL_PROVIDER=soilgrids_rest
SOIL_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query
SOIL_WCS_URL=https://maps.isric.org/mapserv
SOIL_API_KEY=

# Model Artifact Paths
MODEL_PATH=./pest_model/pest_outbreak_model.json
CROP_ENCODER_PATH=./pest_model/crop_encoder.pkl
STAGE_ENCODER_PATH=./pest_model/stage_encoder.pkl
MODEL_CONFIG_PATH=./pest_model/config.json
